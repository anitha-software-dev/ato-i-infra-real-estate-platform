# Database Credentials (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=atoi_infra
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/atoi_infra?schema=public

# AWS S3 Settings (Dummy credentials for development, update for staging/production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy-key
AWS_SECRET_ACCESS_KEY=dummy-secret
AWS_S3_BUCKET_NAME=atoi-infra-bucket

# JWT Config
JWT_SECRET=super-secret-key-change-me
JWT_EXPIRES_IN=1d

# Server Config
PORT=5000
