# AtoI Infra Real Estate Platform - Global Environment Configuration

# Backend API Configuration
PORT=8000
DB_ENGINE=django.db.backends.postgresql
DB_NAME=atoi_infra
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/atoi_infra?schema=public

# JWT Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# AWS S3 Storage (Optional / Production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Frontend & Admin Panel API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
